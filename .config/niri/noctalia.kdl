layout {

    focus-ring {
        active-color   "#c4a7e7"
        inactive-color "#191724"
        urgent-color   "#eb6f92"
    }

    border {
        active-color   "#c4a7e7"
        inactive-color "#191724"
        urgent-color   "#eb6f92"
    }

    shadow {
        color "#19172470"
    }

    tab-indicator {
        active-color   "#c4a7e7"
        inactive-color "#6728b4"
        urgent-color   "#eb6f92"
    }

    insert-hint {
        color "#c4a7e780"
    }
}

recent-windows {
    highlight {
        active-color "#c4a7e7"
        urgent-color "#eb6f92"
    }
}
