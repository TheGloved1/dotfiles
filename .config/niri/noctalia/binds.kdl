// ────────────── Noctalia Shell Keybindings ──────────────
binds {
    // Launchers
    MOD+SPACE hotkey-overlay-title="App launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    MOD+SHIFT+SPACE hotkey-overlay-title="Control Center" { spawn-sh "noctalia msg panel-toggle control-center home"; }
    MOD+C hotkey-overlay-title="Calendar" { spawn-sh "noctalia msg panel-toggle control-center calendar"; }
    MOD+SHIFT+slash hotkey-overlay-title="Noctalia Screen Toolkit" { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all toggle"; }
    MOD+P hotkey-overlay-title="Color picker" { spawn-sh "hyprpicker -a -f hex --lowercase-hex"; }

    // Desktop / Overview
    MOD+A hotkey-overlay-title="Window switcher" { spawn-sh "noctalia msg window-switcher"; }

    // Window Management
    MOD+ALT+SPACE hotkey-overlay-title="Float all windows" { spawn-sh "/home/gloves/.config/niri/scripts/float-all.sh"; }
    MOD+CTRL+Q hotkey-overlay-title="Session menu" { spawn-sh "noctalia msg panel-toggle session"; }
    MOD+SHIFT+Q hotkey-overlay-title="Kill active process" { spawn-sh "/home/gloves/.config/niri/scripts/kill-active.sh"; }
    MOD+CTRL+O hotkey-overlay-title="Toggle opaque" { spawn-sh "/home/gloves/.config/niri/scripts/toggle-opaque.sh"; }

    // Screenshots
    PRINT hotkey-overlay-title="Screenshot selection" { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Shift+PRINT hotkey-overlay-title="Screenshot window" { screenshot; }
    CTRL+SHIFT+PRINT hotkey-overlay-title="Screenshot screen" { screenshot-screen; }
    MOD+PRINT hotkey-overlay-title="Screenshot screen" { spawn-sh "noctalia msg screenshot-fullscreen monitor"; }
    MOD+SHIFT+PRINT hotkey-overlay-title="Screenshot region" { spawn-sh "noctalia msg screenshot-region"; }
    ALT+PRINT hotkey-overlay-title="Screenshot window" { screenshot-window; }
    ALT+SHIFT+S hotkey-overlay-title="Screenshot region freeze" { spawn-sh "noctalia msg plugin gloves/screenshot-actions:service all capture"; }
    MOD+SHIFT+S hotkey-overlay-title="Screenshot region → menu" { spawn-sh "noctalia msg plugin gloves/screenshot-actions:service all capture"; }
    MOD+S hotkey-overlay-title="Screenshot history" { spawn-sh "noctalia msg panel-toggle gloves/screenshot-actions:history"; }
    MOD+SHIFT+O hotkey-overlay-title="OCR" { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all ocr"; }
    MOD+SHIFT+C hotkey-overlay-title="Color picker" { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all colorPicker"; }

    // Audio Controls
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    ALT+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume fine" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+"; }
    ALT+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume fine" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Toggle mic mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Toggle mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Media toggle" { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Media toggle" { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Media next" { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Media previous" { spawn-sh "noctalia msg media previous"; }
    XF86AudioStop allow-when-locked=true hotkey-overlay-title="Media stop" { spawn-sh "noctalia msg media stop"; }

    // Brightness
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness up" { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down" { spawn-sh "noctalia msg brightness-down"; }

    // System / Power
    CTRL+ALT+DELETE hotkey-overlay-title="Session menu" { spawn-sh "noctalia msg panel-toggle session"; }
    CTRL+ALT+L hotkey-overlay-title="Lock screen" { spawn-sh "noctalia msg session lock"; }

    // Appearance / Theme
    MOD+T hotkey-overlay-title="Theme settings" { spawn-sh "noctalia msg settings-open theme"; }
    Mod+N hotkey-overlay-title="Toggle Notifications" { spawn-sh "noctalia msg panel-toggle control-center notifications"; }

    // Wallpaper
    MOD+W hotkey-overlay-title="Select wallpaper" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    MOD+SHIFT+W hotkey-overlay-title="Download wallpapers" { spawn-sh "noctalia msg panel-toggle noctalia/wallhaven:browser"; }

    // Utilities
    MOD+ALT+E hotkey-overlay-title="Emoji menu" { spawn-sh "noctalia msg panel-toggle launcher /emo "; }
    MOD+V hotkey-overlay-title="Clipboard manager" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    MOD+ALT+V hotkey-overlay-title="Discord Voice" { spawn-sh "noctalia msg panel-toggle raycursive/discord-voice:panel"; }
    MOD+SHIFT+E hotkey-overlay-title="Quick settings" { spawn-sh "/home/gloves/.config/niri/scripts/quick-settings.sh"; }
    MOD+CTRL+S hotkey-overlay-title="Screenshare block toggle" { spawn-sh "/home/gloves/.config/niri/scripts/dynamic-rules.sh --window --screencast"; }
    MOD+Z hotkey-overlay-title="Noctalia Settings" { spawn-sh "noctalia msg settings-toggle"; }
    MOD+slash hotkey-overlay-title="Keymap" { spawn-sh "noctalia msg panel-toggle blackbartblues/keymap:panel"; }

    // Screen Recording
    CTRL+ALT+R hotkey-overlay-title="Record screen" { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all start"; }
    MOD+ALT+R hotkey-overlay-title="Record fullscreen" { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all start-fullscreen"; }
    MOD+SHIFT+ALT+R hotkey-overlay-title="Stop recording" { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all stop"; }
    MOD+SHIFT+CTRL+R hotkey-overlay-title="Replay buffer" { spawn-sh "noctalia msg plugin noctalia/screen_recorder:service all replay-start"; }
}
