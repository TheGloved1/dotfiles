// ────────────── Noctalia Startup ──────────────
// Fix for "configured encrypted storage key is missing" (Secret Service race):
// Ensure gnome-keyring secrets is up and env is imported BEFORE Noctalia starts.
// Noctalia v5 auto-reopens when org.freedesktop.secrets appears, but starting
// late can still show the error until you click Settings → Shell → Clipboard → Retry.
spawn-sh-at-startup "gnome-keyring-daemon --start --components=secrets >/dev/null 2>&1 & sleep 0.5; dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP; systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-at-startup "noctalia" "--daemon"
spawn-at-startup "bash" "-c" "$HOME/.config/niri/scripts/noctalia-launcher-auto-placement.sh"
