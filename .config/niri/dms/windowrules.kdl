// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1787576639021588085 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=wr_1787578555948205905 @name=steam
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=4 y=4 relative-to="bottom-right"
}

// @id=wr_1787578615781201995 @name=Rule
window-rule {
    opacity 0.95
    scroll-factor 0.75
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        noise 0.02
        saturation 3
    }
}

// @id=wr_1787578638165759447 @name=firefox$
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}

// @id=wr_1787578649366531950 @name=^dev\.noctalia\.Noctalia$
window-rule {
    match app-id="^dev\\.noctalia\\.Noctalia$"
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 920; }
}

// @id=wr_1787578653296760616 @name=^(pavucontrol|org\.pulseaudio\.pavucontrol|com\.saivert\.pwvucontrol|blueman-manager|nm-applet|nm-connection-editor)$
window-rule {
    match app-id="^(pavucontrol|org\\.pulseaudio\\.pavucontrol|com\\.saivert\\.pwvucontrol|blueman-manager|nm-applet|nm-connection-editor)$"
    open-floating true
}

// @id=wr_1787578661613133489 @name=^(org\.kde\.polkit-kde-authentication-agent-1|mate-polkit)$
window-rule {
    match app-id="^(org\\.kde\\.polkit-kde-authentication-agent-1|mate-polkit)$" title="^Authentication.*$"
    open-floating true
}

// @id=wr_1787578665933149992 @name=^qalculate-gtk$
window-rule {
    match app-id="^qalculate-gtk$" title="^Qalculate.*$"
    open-floating true
}

// @id=wr_1787578671081588969 @name=^(mpv|com\.github\.rafostar\.Clapper)$
window-rule {
    match app-id="^(mpv|com\\.github\\.rafostar\\.Clapper)$"
    open-floating true
}

// @id=wr_1787578676495286703 @name=^Bitwarden$
window-rule {
    match app-id="^Bitwarden$"
    open-floating true
}

// @id=wr_1787578680162559675 @name=^(org\.cachyos\.KernelManager|mainline-gtk|org\.kde\.kwalletmanager|nvidia-settings|org\.cachyos\.cachyos-pi|com\.shellyorg\.shelly|CachyOSHello|octopi.*|garuda-assistant|com\.github\.hyprmod|com\.github\.wwmm\.easyeffects|nz\.co\.mega\.megasync|io\.github\.amit9838\.mousam|btrfs-assistant|timeshift-gtk|org\.gnome\.Calculator|qalculate-gtk)$
window-rule {
    match app-id="^(org\\.cachyos\\.KernelManager|mainline-gtk|org\\.kde\\.kwalletmanager|nvidia-settings|org\\.cachyos\\.cachyos-pi|com\\.shellyorg\\.shelly|CachyOSHello|octopi.*|garuda-assistant|com\\.github\\.hyprmod|com\\.github\\.wwmm\\.easyeffects|nz\\.co\\.mega\\.megasync|io\\.github\\.amit9838\\.mousam|btrfs-assistant|timeshift-gtk|org\\.gnome\\.Calculator|qalculate-gtk)$"
    open-floating true
}

// @id=wr_1787578684444938159 @name=^steam$
window-rule {
    match app-id="^steam$" title="^Steam$"
    open-floating false
}

// @id=wr_1787578688513327342 @name=^steam$
window-rule {
    match app-id="^steam$"
    open-floating true
}

// @id=wr_1787578691612204940 @name=^(gamescope|steam_app_\d+)$
window-rule {
    match app-id="^(gamescope|steam_app_\\d+)$"
    open-floating false
}

// @id=wr_1787578704078971405 @name=Rule
window-rule {
    match title="^(Authentication Required|Save As|Add Folder to Workspace|Open Files)$"
    open-floating true
}

// @id=wr_1787578711930694307 @name=Rule
window-rule {
    match title="^[Pp]icture-in-[Pp]icture$"
    open-floating true
}

// @id=wr_1787578722613712502 @name=^org\.quickshell$
window-rule {
    match app-id="^org\\.quickshell$"
    match title="(?i)settings"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 700; }
}
