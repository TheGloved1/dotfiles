// ────────────── DankMaterialShell Keybindings ──────────────
binds {
    // Launchers
    MOD+SPACE hotkey-overlay-title="App launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    MOD+SHIFT+SPACE hotkey-overlay-title="Control Center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    MOD+X hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    MOD+Z hotkey-overlay-title="DMS Settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    MOD+C hotkey-overlay-title="Calendar" { spawn-sh "notify-send 'Calendar' 'Feature not implemented yet'"; }
    MOD+SHIFT+slash hotkey-overlay-title="Dank Menu" { spawn "dms" "ipc" "call" "dankMenu" "toggle" "root"; }
    MOD+P hotkey-overlay-title="Color picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }
    Alt+Space hotkey-overlay-title="Spotlight Bar" {
        spawn "dms" "ipc" "call" "spotlight-bar" "toggle";
    }

    // Desktop / Overview
    MOD+A hotkey-overlay-title="Window switcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }

    // Window Management
    MOD+ALT+SPACE hotkey-overlay-title="Float all windows" { spawn-sh "/home/gloves/.config/niri/scripts/float-all.sh"; }
    MOD+CTRL+Q hotkey-overlay-title="Session menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    MOD+SHIFT+Q hotkey-overlay-title="Kill active process" { spawn-sh "/home/gloves/.config/niri/scripts/kill-active.sh"; }
    MOD+CTRL+O hotkey-overlay-title="Toggle opaque" { spawn-sh "/home/gloves/.config/niri/scripts/toggle-opaque.sh"; }

    // Screenshots - dms screenshot CLI
    Print hotkey-overlay-title="Screenshot selection" { spawn "dms" "screenshot"; }
    Shift+Print hotkey-overlay-title="Screenshot window + cursor" { spawn "dms" "screenshot" "window" "--cursor=on"; }
    CTRL+SHIFT+Print hotkey-overlay-title="Screenshot screen no clipboard" { spawn "dms" "screenshot" "full" "--no-clipboard"; }
    MOD+Print hotkey-overlay-title="Screenshot screen + cursor" { spawn "dms" "screenshot" "full" "--cursor=on"; }
    MOD+SHIFT+Print hotkey-overlay-title="Screenshot region no confirm" { spawn "dms" "screenshot" "--no-confirm"; }
    ALT+Print hotkey-overlay-title="Screenshot window no clipboard" { spawn "dms" "screenshot" "window" "--no-clipboard"; }
    ALT+SHIFT+S hotkey-overlay-title="Screenshot region freeze" { spawn-sh "notify-send 'Screenshot region freeze' 'Feature not implemented yet'"; }
    MOD+SHIFT+S hotkey-overlay-title="Screenshot region" { spawn "dms" "screenshot"; }
    MOD+S hotkey-overlay-title="Screenshot history" { spawn-sh "notify-send 'Screenshot history' 'Feature not implemented yet'"; }
    MOD+SHIFT+O hotkey-overlay-title="OCR" { spawn-sh "notify-send 'OCR' 'Feature not implemented yet'"; }
    MOD+SHIFT+C hotkey-overlay-title="Color picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }

    // Audio Controls - DMS IPC
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    ALT+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume fine" { spawn "dms" "ipc" "call" "audio" "increment" "1"; }
    ALT+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume fine" { spawn "dms" "ipc" "call" "audio" "decrement" "1"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Toggle mic mute" { spawn "dms" "ipc" "call" "mic" "mute"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Toggle mute" { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Media toggle" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Media toggle" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Media next" { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Media previous" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioStop allow-when-locked=true hotkey-overlay-title="Media stop" { spawn "dms" "ipc" "call" "mpris" "stop"; }

    // Brightness - DMS IPC
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness up" { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down" { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

    // System / Power
    CTRL+ALT+DELETE hotkey-overlay-title="Session menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    CTRL+ALT+L hotkey-overlay-title="Lock screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    MOD+SHIFT+N hotkey-overlay-title="Notifications" { spawn "dms" "ipc" "call" "notifications" "toggle"; }

    // Appearance / Theme
    MOD+T hotkey-overlay-title="Theme settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+N hotkey-overlay-title="Toggle night light" { spawn "dms" "ipc" "call" "night" "toggle"; }

    // Wallpaper
    MOD+W hotkey-overlay-title="Select wallpaper" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    MOD+SHIFT+W hotkey-overlay-title="Download wallpapers" { spawn-sh "notify-send 'Download wallpapers' 'Feature not implemented yet'"; }

    // Utilities
    MOD+ALT+E hotkey-overlay-title="Emoji menu" { spawn-sh "notify-send 'Emoji menu' 'Feature not implemented yet'"; }
    MOD+V hotkey-overlay-title="Clipboard manager" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    MOD+ALT+V hotkey-overlay-title="Discord Voice" { spawn-sh "notify-send 'Discord Voice' 'Feature not implemented yet'"; }
    MOD+SHIFT+E hotkey-overlay-title="Quick settings" { spawn-sh "/home/gloves/.config/niri/scripts/quick-settings.sh"; }
    MOD+CTRL+S hotkey-overlay-title="Screenshare block toggle" { spawn-sh "/home/gloves/.config/niri/scripts/dynamic-rules.sh --window --screencast"; }
    MOD+CTRL+ALT+L hotkey-overlay-title="Layer block toggle (demo)" { spawn-sh "/home/gloves/.config/niri/scripts/dynamic-rules.sh --layer --screencast"; }

    // Screen Recording
    CTRL+ALT+R hotkey-overlay-title="Record screen" { spawn-sh "notify-send 'Record screen' 'Feature not implemented yet'"; }
    MOD+ALT+R hotkey-overlay-title="Record fullscreen" { spawn-sh "notify-send 'Record fullscreen' 'Feature not implemented yet'"; }
    MOD+SHIFT+ALT+R hotkey-overlay-title="Stop recording" { spawn-sh "notify-send 'Stop recording' 'Feature not implemented yet'"; }
    MOD+SHIFT+CTRL+R hotkey-overlay-title="Replay buffer" { spawn-sh "notify-send 'Replay buffer' 'Feature not implemented yet'"; }
}
