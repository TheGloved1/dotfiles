-- KoolDots Hyprland Lua config entrypoint.
-- Generated by hyprlang2lua — sources converted .lua files directly.
local configHome = os.getenv("XDG_CONFIG_HOME") or (os.getenv("HOME") .. "/.config")
local hyprDir = configHome .. "/hypr"
local configsDir = hyprDir .. "/configs"
local userDir = hyprDir .. "/UserConfigs"

-- Load system defaults first, then user overrides (matching hyprland.conf source order)

-- User defaults (terminal, file manager, etc.)
dofile(userDir .. "/01-UserDefaults.lua")

-- Keybinds
dofile(configsDir .. "/Keybinds.lua")
dofile(userDir .. "/UserKeybinds.lua")

-- Startup apps
dofile(configsDir .. "/Startup_Apps.lua")
dofile(userDir .. "/Startup_Apps.lua")

-- Environment variables
dofile(configsDir .. "/ENVariables.lua")
dofile(userDir .. "/ENVariables.lua")

-- Laptops
dofile(configsDir .. "/Laptops.lua")
dofile(userDir .. "/Laptops.lua")
dofile(userDir .. "/LaptopDisplay.lua")

-- Window rules
dofile(configsDir .. "/WindowRules.lua")
dofile(userDir .. "/WindowRules.lua")

-- Settings
dofile(configsDir .. "/SystemSettings.lua")
dofile(userDir .. "/UserSettings.lua")

-- Layer rules
dofile(configsDir .. "/LayerRules.lua")
dofile(userDir .. "/LayerRules.lua")

-- Monitors
dofile(configsDir .. "/Monitors.lua")

-- Workspace rules
dofile(userDir .. "/WorkSpaceRules.lua")

-- Animations
dofile(userDir .. "/UserAnimations.lua")

-- Decorations
dofile(userDir .. "/UserDecorations.lua")
