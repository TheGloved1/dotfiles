#!/usr/bin/env bash
set -u
set -o pipefail

CACHE_FILE="${HOME}/.cache/rofi-emacs-keybinds.txt"

if [[ ! -s "${CACHE_FILE}" ]]; then
  notify-send "Emacs Keybinds" "Keybind cache missing. In Emacs, run: M-x rofi-emacs-keybinds-refresh"
  exit 1
fi

noctalia dmenu -p "Emacs Keybinds" < "${CACHE_FILE}"