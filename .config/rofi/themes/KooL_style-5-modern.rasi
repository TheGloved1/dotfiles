/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* KooL Hyprland Rofi Style 5 — Modern */

/* ---- Configuration ---- */
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "  ";
    display-run:                "  ";
    display-filebrowser:        "  ";
    display-window:             "  ";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}


/* ---- Load wallust colors ---- */
@theme "~/.config/rofi/wallust/colors-rofi.rasi"

/* ---- Global Properties ---- */
* {

    background-alt:              @color1;
    selected:                    @color12;
    active:                      @color11;
    urgent:                      @color13;

    text-selected:               @background;
    text-color:                  @foreground;
    border-color:                @selected;
}


/* ---- Window ---- */
window {
    width:						800px;
    x-offset:                   0px;
    y-offset:                   0px;
    spacing:                    0px;
    padding:                    1px;
    margin:                     1px;
    border:                     0px;
    cursor:                     "default";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    enabled:                    true;
    border-radius:              6px;
 	background-color:           @background-color;
}

/* ---- Mainbox ---- */
mainbox {
    enabled:                    true;
    orientation:                vertical;
	padding:					8px;
    background-image:           url("~/.config/rofi/.current_wallpaper_focused", width);
    children:                   [ "inputbar", "listbox" ];
    border-radius:              6px;
}

/* ---- Listbox ---- */
listbox {
    spacing:                    4px;
    orientation:                vertical;
    children:                   [ "message", "listview" ];
	padding:					10px;
    border-radius:              6px;
    border:                     0px;
	background-color:		    transparent;
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                    true;
    text-color:                 @foreground;
    spacing:                    10px;
    padding:                    4px;
    border-radius:              6px;
	background-color:		    @background;
    children:                   [ "mode-switcher", "textbox-prompt-colon", "entry" ];
    border:                     0px;
}

textbox-prompt-colon {
    enabled:                    true;
	padding:					10px 0px 10px 10px;
    expand:                     false;
    str:                        "🐧";
    text-color:                 inherit;
	background-color:			transparent;
}

entry {
    enabled:                    true;
	padding:					10px 0px 10px 0px;
    text-color:                 @foreground;
    cursor:                     text;
    placeholder:                "  Search";
    placeholder-color:          inherit;
	background-color:			@background;
    border-radius:              6px;
}

/* ---- Mode Switcher ---- */
mode-switcher{
    enabled:                    true;
    spacing:                    10px;
    background-color:          	transparent;
    text-color:                 @foreground;
}

button {
    padding:                   2px 24px 2px 24px;
    border-radius:             6px;
    background-color:          @background-color;
    text-color:                inherit;
    cursor:                    pointer;
    border:                    0px;
}

button selected {
    background-color:          @selected;
    text-color:                @background;
    border:                    0px;
}

/* ---- Listview ---- */
listview {
	enabled:					true;
	columns:					2;
	lines:						6;
	spacing:                    6px;
	padding:					6px;
	dynamic:                    true;
	cycle:                      true;
	scrollbar:                  false;
	layout:                     vertical;
	reverse:                    false;
	fixed-height:               true;
	fixed-columns:              false;
	background-color:           @background-color;
	border-radius:   	        6px;
	border:						0px;
}

/* ---- Element ---- */
element {
    enabled:                    true;
    padding:                    12px;
    margin:                     2px;
    cursor:                     pointer;
    background-color:           transparent;
    opacity:                    0.5;
    border-radius:              6px;
    border:                     0px;
}

element-text {
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       32px;
    cursor:                     inherit;
}

element selected.normal {
    background-color:           @selected;
    text-color:                 @background;
}

/* ---- Message ---- */
message {
    background-color:            transparent;
    border:                      0px;
}
textbox {
    padding:                     12px;
    border-radius:               6px;
    background-color:            @background;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
error-message {
    padding:                     12px;
    border-radius:               6px;
    background-color:            @background-alt;
    text-color:                  @background;
}
