 /* wallust template - colors-rofi */

* {
active-background: #8AADF4;
active-foreground: #CAD3F5;
normal-background: #24273A;
normal-foreground: #CAD3F5;
urgent-background: #F5BDE6;
urgent-foreground: #CAD3F5;

alternate-active-background: #EED49F;
alternate-active-foreground: #CAD3F5;
alternate-normal-background: #24273A;
alternate-normal-foreground: #CAD3F5;
alternate-urgent-background: #24273A;
alternate-urgent-foreground: #CAD3F5;

selected-active-background: #8AADF4;
selected-active-foreground: #000000;
selected-normal-background: #8AADF4;
selected-normal-foreground: #000000;
selected-urgent-background: #8AADF4;
selected-urgent-foreground: #000000;

background-color: #24273D;
background: rgba(0,0,0,0.4);
foreground: #CAD3F5;
border-color: #8AADF4;

color0: #494D64;
color1: #ED8796;
color2: #A6DA95;
color3: #EED49F;
color4: #8AADF4;
color5: #F5BDE6;
color6: #8BD5CA;
color7: #B8C0E0;
color8: #5B6078;
color9: #ED8796;
color10: #A6DA95;
color11: #EED49F;
color12: #8AADF4;
color13: #F5BDE6;
color14: #8BD5CA;
color15: #A5ADCB;


}

