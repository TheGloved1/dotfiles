#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ocp [-n N] [-h]

Fuzzy-pick an opencode session by title and resume it.

Options:
  -n N   limit to N most recent sessions
  -h     show this help
EOF
}

MAX_COUNT=""
while getopts ":n:h" opt; do
  case "$opt" in
    n) MAX_COUNT="$OPTARG" ;;
    h) usage; exit 0 ;;
    \?) echo "ocp: unknown option -$OPTARG" >&2; usage; exit 1 ;;
  esac
done

command -v opencode >/dev/null || { echo "ocp: opencode not found" >&2; exit 1; }
command -v fzf >/dev/null || { echo "ocp: fzf not found" >&2; exit 1; }
command -v python3 >/dev/null || { echo "ocp: python3 not found" >&2; exit 1; }
command -v sqlite3 >/dev/null || { echo "ocp: sqlite3 not found" >&2; exit 1; }

LIMIT=100
if [ -n "$MAX_COUNT" ]; then
  case "$MAX_COUNT" in
    ''|*[!0-9]*|0) echo "ocp: -n requires a positive integer" >&2; exit 1 ;;
  esac
  LIMIT="$MAX_COUNT"
fi

# Query globally: `opencode session list` is project-scoped in v2 and
# returns [] outside the session's project directory.
# NOTE: opencode v2 stores sessions in `session_v2`; the legacy `session`
# table stopped receiving new rows after 1.18.x, so query session_v2 first.
DB="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"
[ -f "$DB" ] || { echo "ocp: session database not found at $DB" >&2; exit 1; }

if [ "$(sqlite3 -readonly "$DB" "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='session_v2';")" = "1" ]; then
  SESSION_TABLE="session_v2"
else
  SESSION_TABLE="session"
fi

json="$(sqlite3 -readonly -json "$DB" \
  "SELECT id, title, directory, time_updated FROM $SESSION_TABLE WHERE parent_id IS NULL OR parent_id = '' ORDER BY time_updated DESC LIMIT $LIMIT;")" ||
  { echo "ocp: failed to list sessions" >&2; exit 1; }
[ -n "$json" ] || { echo "ocp: no sessions found" >&2; exit 1; }

lines="$(python3 - "$json" <<'PY'
import json, sys
from datetime import datetime

data = json.loads(sys.argv[1])
now = datetime.now()
for s in data:
    title = s.get("title") or ""
    title = title.replace("\t", " ").replace("\n", " ").strip()
    updated = s.get("time_updated", s.get("updated"))
    t = datetime.fromtimestamp(updated / 1000)
    delta = now - t
    secs = delta.total_seconds()
    if secs < 60:
        rel = "just now"
    elif secs < 3600:
        rel = f"{int(secs // 60)}m ago"
    elif secs < 86400:
        rel = f"{int(secs // 3600)}h ago"
    elif delta.days < 30:
        rel = f"{delta.days}d ago"
    else:
        rel = t.strftime("%Y-%m-%d")
    directory = (s.get("directory") or "").replace("\t", " ").replace("\n", " ").strip()
    print(f"{s['id']}\t{title}\t{rel}\t{directory}")
PY
)"

[ -n "$lines" ] || { echo "ocp: no sessions found" >&2; exit 1; }

sel="$(printf '%s\n' "$lines" | fzf \
  --height 40% \
  --delimiter=$'\t' \
  --with-nth=2.. \
  --header 'Enter: resume session | Esc: cancel' \
  --preview 'printf "directory: %s\n" "{4}"' \
  --preview-window=down:1:wrap \
  || true)"

[ -n "$sel" ] || exit 130

id="$(printf '%s\n' "$sel" | cut -f1)"
[ -n "$id" ] || { echo "ocp: could not parse selection" >&2; exit 1; }

dir="$(printf '%s\n' "$sel" | cut -f4)"
if [ -n "$dir" ] && [ -d "$dir" ]; then
  cd "$dir" || { echo "ocp: cannot cd to $dir" >&2; exit 1; }
fi

exec opencode -s "$id"